# AI S&P Trading Bot — gitignore
# Data directory (SQLite state DB, scan caches, bar caches — D-09)
data/

# EOD HTML reports (D-16: generated at runtime, not committed)
reports/

# Launchd StandardOut/StandardError logs (D-06)
logs/

# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# Test caches
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Editor / OS artifacts
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# Environment variable files (never commit secrets)
.env

# Distribution / build artifacts
*.egg-info/
dist/
build/

# Backtester scratch (CSV cache + per-run scratch StateStore DBs)
backtester/cache/
backtester/runs/
