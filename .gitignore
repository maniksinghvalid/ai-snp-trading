.pytest_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Editor / OS artifacts
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# Environment variable files (never commit secrets)
.env

# Distribution / build artifacts
*.egg-info/
dist/
build/
