# ============================================================
# AI S&P Trading Bot — environment configuration (TEMPLATE)
# ============================================================
# Copy to `.env` and fill in your values. `.env` is gitignored.
#
# This project does NOT auto-load .env (no python-dotenv). Load it into
# your shell before running the bot or tests, or supply the same values
# via the launchd EnvironmentVariables dict (deploy/com.bot.trading.plist):
#
#     set -a; source .env; set +a
#     python -m bot
#
# ------------------------------------------------------------
# Paper-safety (REQUIRED — the bot hard-fails without these)
# ------------------------------------------------------------
# PAPER_TRADING must be exactly "true" or the paper guard refuses to run (D-03).
PAPER_TRADING=true
# FUTU_TRD_ENV must be SIMULATE for paper trading (D-03). REAL is rejected by the guard.
FUTU_TRD_ENV=SIMULATE

# ------------------------------------------------------------
# OpenD connection (must be running + logged in on this host:port)
# ------------------------------------------------------------
FUTU_OPEND_HOST=127.0.0.1
FUTU_OPEND_PORT=11111
FUTU_DEFAULT_MARKET=US

# Optional — leave blank to auto-detect.
FUTU_SECURITY_FIRM=
# Default account id; 0 = first account returned by get_acc_list().
FUTU_ACC_ID=0

# Optional OpenD login (usually configured in the OpenD GUI instead).
FUTU_LOGIN_ACCOUNT=
FUTU_LOGIN_PWD=

# ------------------------------------------------------------
# Telegram alerts (optional — bot no-ops if unset, D-12/D-13)
# ------------------------------------------------------------
# TELEGRAM_BOT_TOKEN: Create a bot via Telegram @BotFather -> /newbot
#   and copy the HTTP API token shown (e.g. 123456:ABC-DEF...).
TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID: Send any message to your bot, then call:
#   GET https://api.telegram.org/bot<TOKEN>/getUpdates
#   and read result[0].message.chat.id (a positive or negative integer).
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------
# Bot runtime paths (optional — sensible defaults if unset)
# ------------------------------------------------------------
# BOT_STATE_DB=data/bot_state.db
# BOT_KILL_FILE=/tmp/bot.kill
