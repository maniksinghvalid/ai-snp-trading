<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  deploy/com.bot.ibs.plist — launchd LaunchAgent TEMPLATE for the IBS ETF bot (Phase 12, D-14)

  INSTRUCTIONS:
    1. Fill in all OPERATOR placeholder values (paths, secrets).
    2. chmod 600 ~/Library/LaunchAgents/com.bot.ibs.plist  (T-05-04-02: secrets in env block)
    3. DO NOT commit a filled-in copy of this file — keep secrets out of git history.
    4. Load:    launchctl load ~/Library/LaunchAgents/com.bot.ibs.plist
       Status:  launchctl list | grep com.bot.ibs
       Unload:  launchctl unload ~/Library/LaunchAgents/com.bot.ibs.plist
                (sends SIGTERM: same graceful stop as touch .bot_kill_ibs — the in-flight
                 decision is cancelled and working orders are swept; positions stay held)

  ThrottleInterval (D-06): launchd waits at least this many seconds between crash-restarts.
  Increase to 60 if the bot is crash-looping on a persistent error.
-->
<plist version="1.0">
<dict>

    <!-- ============================================================ -->
    <!-- Service identity                                              -->
    <!-- ============================================================ -->

    <key>Label</key>
    <string>com.bot.ibs</string>

    <!-- ============================================================ -->
    <!-- Program — use the FULL path to the venv Python (Pitfall 6)  -->
    <!-- launchd does NOT source .bashrc/.zshrc; system PATH is bare  -->
    <!-- ============================================================ -->

    <key>ProgramArguments</key>
    <array>
        <!-- REPLACE with full absolute path to your virtualenv Python binary -->
        <string>/Users/OPERATOR/path/to/venv/bin/python</string>
        <string>-m</string>
        <string>bot</string>
        <string>--rules</string>
        <string>rules_ibs.json</string>
    </array>

    <!-- Working directory: the MAIN checkout on develop - worktree changes are inert until merged -->
    <key>WorkingDirectory</key>
    <string>/Users/OPERATOR/path/to/ai-snp-trading-claude</string>

    <!-- ============================================================ -->
    <!-- Supervision (D-05 / D-06)                                    -->
    <!-- ============================================================ -->

    <!-- KeepAlive SuccessfulExit=false: restart only after a CRASH (non-zero exit). -->
    <!-- A `touch .bot_kill_ibs` shutdown exits 0 and must NOT be restarted.          -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- RunAtLoad: start the agent immediately when loaded (and on login) -->
    <key>RunAtLoad</key>
    <true/>

    <!-- ThrottleInterval: minimum seconds between crash-restarts (D-06).  -->
    <!-- Keep at 30 unless the bot is crash-looping on a persistent error (then 60). -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <!-- ExitTimeOut: seconds launchd waits after SIGTERM before SIGKILL (default 20). -->
    <!-- The graceful stop cancels the decision and sweeps orders; each status read   -->
    <!-- can back off ~9 s on the rate limit, so 20 s can cut it short.               -->
    <key>ExitTimeOut</key>
    <integer>60</integer>

    <!-- ============================================================ -->
    <!-- Environment variables (D-05/D-13)                            -->
    <!-- Paper-safety flags are HARDCODED here (T-05-04-SAFE).        -->
    <!-- Telegram secrets: fill in and chmod 600 the plist file.      -->
    <!-- PATH must be explicit; launchd does not source shell profiles  -->
    <!-- ============================================================ -->

    <key>EnvironmentVariables</key>
    <dict>

        <!-- Paper-trading safety — hardcoded, never change to REAL here -->
        <key>PAPER_TRADING</key>
        <string>true</string>

        <key>FUTU_TRD_ENV</key>
        <string>SIMULATE</string>

        <!-- Paper-guard Guard 3 fails without an explicit account id -->
        <key>FUTU_ACC_ID</key>
        <string>1727266</string>

        <key>PYTHONUNBUFFERED</key>
        <string>1</string>

        <!-- OpenD connection (defaults match the local OpenD service) -->
        <key>FUTU_OPEND_HOST</key>
        <string>127.0.0.1</string>

        <key>FUTU_OPEND_PORT</key>
        <string>11111</string>

        <!-- Telegram secrets — fill these in; DO NOT commit the filled-in plist -->
        <key>TELEGRAM_BOT_TOKEN</key>
        <string>YOUR_TOKEN_HERE</string>

        <key>TELEGRAM_CHAT_ID</key>
        <string>YOUR_CHAT_ID_HERE</string>

        <!-- Explicit PATH: launchd's default PATH is /usr/bin:/bin only (Pitfall 6) -->
        <!-- Add /opt/homebrew/bin for Apple Silicon Homebrew; /usr/local/bin for Intel -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>

    </dict>

    <!-- ============================================================ -->
    <!-- Log redirection (SVC-03 / D-06)                              -->
    <!-- logs/ is gitignored; launchd creates the files if missing    -->
    <!-- ============================================================ -->

    <key>StandardOutPath</key>
    <string>/Users/OPERATOR/path/to/ai-snp-trading-claude/logs/ibs.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/OPERATOR/path/to/ai-snp-trading-claude/logs/ibs.stderr.log</string>

</dict>
</plist>
